# ─────────────────────────────────────────────────────────────────
# LinkedIn Intelligence — Variables de entorno
# Copiá este archivo como .env y completá los valores
# NUNCA commitees el .env con valores reales
# ─────────────────────────────────────────────────────────────────

# App
ENVIRONMENT=development          # development | staging | production
SECRET_KEY=change-me-in-production-minimum-32-random-chars
DEBUG=true
APP_VERSION=0.1.0

# Database
POSTGRES_USER=linkedin_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=linkedin_intelligence
DATABASE_URL=postgresql+asyncpg://linkedin_user:changeme@localhost:5432/linkedin_intelligence

# Redis
REDIS_URL=redis://localhost:6379

# LLM — Anthropic (primario)
ANTHROPIC_API_KEY=sk-ant-api03-...

# LLM — OpenAI (fallback + embeddings)
OPENAI_API_KEY=sk-proj-...

# Crawlers
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=LinkedInIntelligence-Bot/1.0

GITHUB_TOKEN=ghp_...

# Observabilidad (opcional en desarrollo)
SENTRY_DSN=
LANGCHAIN_API_KEY=              # Para LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=linkedin-intelligence

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
